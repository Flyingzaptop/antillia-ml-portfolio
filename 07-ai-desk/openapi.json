{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Desk",
    "version": "1.0.0",
    "description": "See API.md for schemas, CSRF and SSE contracts"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "GET health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "summary": "GET session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "summary": "POST login",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "summary": "POST logout",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      }
    },
    "/api/v1/chats": {
      "get": {
        "summary": "GET chats",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      },
      "post": {
        "summary": "POST chats",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      }
    },
    "/api/v1/chats/{id}": {
      "get": {
        "summary": "GET chats/{id}",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      },
      "delete": {
        "summary": "DELETE chats/{id}",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ]
    },
    "/api/v1/chats/{id}/ask": {
      "post": {
        "summary": "POST chats/{id}/ask",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "pl",
                      "en"
                    ],
                    "default": "pl"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ]
    },
    "/api/v1/documents": {
      "get": {
        "summary": "GET documents",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      },
      "post": {
        "summary": "POST documents",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      }
    },
    "/api/v1/sources/{id}": {
      "get": {
        "summary": "GET sources/{id}",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Permission or CSRF denied"
          }
        }
      },
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ]
    },
    "/api/v1/readiness": {
      "get": {
        "summary": "Probe encoder, index and local generator availability",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "aidesk_session"
      },
      "CSRFHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRFToken"
      }
    }
  },
  "security": [
    {
      "SessionCookie": []
    }
  ]
}